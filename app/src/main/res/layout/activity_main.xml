<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fv_surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/fv_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fv_setup_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setup_title"
                android:textColor="@color/fv_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/setup_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/allow_microphone" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tab_scroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/tab_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkedButton="@id/tab_model"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/tab_model"
                    style="@style/Widget.FreeVoice.Tab"
                    android:text="@string/tab_model" />

                <RadioButton
                    android:id="@+id/tab_prompt"
                    style="@style/Widget.FreeVoice.Tab"
                    android:text="@string/tab_prompt" />

                <RadioButton
                    android:id="@+id/tab_history"
                    style="@style/Widget.FreeVoice.Tab"
                    android:text="@string/tab_history" />

                <RadioButton
                    android:id="@+id/tab_logs"
                    style="@style/Widget.FreeVoice.Tab"
                    android:text="@string/tab_logs" />
            </RadioGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
