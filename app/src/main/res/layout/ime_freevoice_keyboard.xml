<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ime_freevoice_background"
    android:orientation="vertical">

    <!--
      キーボード本体。高さは中身の合計。
      システムのナビゲーションバー（戻る矢印・IME切替アイコン）と重ならないようにする役目は
      下の ime_nav_spacer が担う（高さはインセットに応じて実行時に決まる）。
      paddingBottom はそれとは別に、最下段キーが spacer との境界ぎりぎりに来て
      誤タップしないよう置いている固定の緩衝地帯。数値上は 240dp を決めた際の
      端数（28dp）に由来するが、キー下の見た目の余裕として意図的に残しているので、
      「使われていない余白」と誤解して削らないこと。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="38dp">

        <!--
          ブランドは独立した行にする。取消ボタンと同じ行に置くと、行の高さが
          ボタンのタップ領域に縛られて、小さい文字のまわりに大きな余白だけが残る。
          高さは wrap_content（中身が必要とするぶんだけ）。
          余白が中身ぶんだけになったので、文字は元のサイズのまま置ける。
          文字色は控えめにして、状態表示より目立たせない。
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              アイコンは compound drawable ではなく別ビューにする。
              TextView の drawableStart だと大きさを指定できず、
              24dp の素材が 15sp の文字に対して大きすぎるため。
            -->
            <ImageView
                android:id="@+id/ime_brand_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/ime_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/app_name"
                android:textColor="@color/ime_muted"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
          状態行。ドット・経過時間・メッセージ・取消をまとめて持つ。
          高さは取消ボタンのタップ領域で決まる。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ime_status_indicator"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/ime_status_dot"
                android:textColor="@color/ime_status_idle"
                android:textSize="11sp" />

            <!--
              経過時間。本文とは別ビューにしている
              （同じ TextView だと先頭省略のときに時間ごと消える）。
              録音中以外は GONE にする。空文字のままだと marginEnd だけが残って
              本文の開始位置がずれるため。
            -->
            <TextView
                android:id="@+id/ime_timer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:textColor="@color/ime_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!--
              メッセージ本文。左端のドットに合わせて常に左寄せにする
              （文言だけ中央に来ると、行の起点が揃わず落ち着かない）。
              ImeKeyboardUi が切り替えるのは省略の向きだけ:
              - 案内・状態文言: 末尾を省略
              - 認識中のテキスト: 先頭を省略（末尾＝いま話した内容を残すため）
              どの状態でも必ず何か出るので、この行が空になることはない。
            -->
            <TextView
                android:id="@+id/ime_status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:singleLine="true"
                android:text="@string/ime_idle"
                android:textColor="@color/ime_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/ime_cancel"
                style="@style/Widget.FreeVoice.ImeTextKey"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:minHeight="40dp"
                android:background="@drawable/ime_cancel_background"
                android:minWidth="64dp"
                android:text="@string/ime_cancel"
                android:textColor="@color/ime_error"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/ime_mic"
            style="@style/Widget.FreeVoice.ImePrimaryKey"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_mic"
            android:drawablePadding="10dp"
            android:text="@string/ime_record_start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="5.5">

            <Button
                android:id="@+id/ime_settings"
                style="@style/Widget.FreeVoice.ImeIconKey"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.1"
                android:contentDescription="@string/ime_settings"
                android:drawableStart="@drawable/ic_ime_settings" />

            <Button
                android:id="@+id/ime_space"
                style="@style/Widget.FreeVoice.ImeTextKey"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="2.4"
                android:contentDescription="@string/ime_space_description"
                android:text="@string/ime_space" />

            <Button
                android:id="@+id/ime_delete"
                style="@style/Widget.FreeVoice.ImeIconKey"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/ime_delete"
                android:drawableStart="@drawable/ic_ime_backspace" />

            <Button
                android:id="@+id/ime_enter"
                style="@style/Widget.FreeVoice.ImeIconKey"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/ime_enter"
                android:drawableStart="@drawable/ic_ime_enter" />
        </LinearLayout>
    </LinearLayout>

    <!--
      システムのナビゲーションバー（戻る矢印・IME切替アイコン）が実際に重なる領域。
      キーとナビバーが重ならないようにしているのはこの View（高さは
      ImeKeyboardUi.applyNavigationBarInset() が navigationBars() インセットから設定する）。
      ここにはキーを置かない。上の本体側の paddingBottom はこれとは別の、
      キー下の誤タップ防止用の固定の緩衝地帯。
    -->
    <View
        android:id="@+id/ime_nav_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:importantForAccessibility="no" />
</LinearLayout>
