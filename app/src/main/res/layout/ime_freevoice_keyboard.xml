<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:background="@drawable/ime_freevoice_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ime_brand"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/ime_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ime_status_indicator"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/ime_status_dot"
            android:textColor="@color/ime_status_idle"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/ime_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/ime_idle"
            android:textColor="@color/ime_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/ime_cancel"
            style="@style/Widget.FreeVoice.ImeTextKey"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/ime_cancel_background"
            android:minWidth="64dp"
            android:text="@string/ime_cancel"
            android:textColor="@color/ime_error"
            android:visibility="gone" />

        <Button
            android:id="@+id/ime_settings"
            style="@style/Widget.FreeVoice.ImeIconKey"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ime_settings"
            android:drawableStart="@drawable/ic_ime_settings" />
    </LinearLayout>

    <Button
        android:id="@+id/ime_mic"
        style="@style/Widget.FreeVoice.ImePrimaryKey"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_mic"
        android:drawablePadding="10dp"
        android:text="@string/ime_record_start" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="5.5">

        <Button
            android:id="@+id/ime_switch"
            style="@style/Widget.FreeVoice.ImeIconKey"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.1"
            android:contentDescription="@string/ime_switch"
            android:drawableStart="@drawable/ic_ime_switch_keyboard" />

        <Button
            android:id="@+id/ime_space"
            style="@style/Widget.FreeVoice.ImeTextKey"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="2.4"
            android:contentDescription="@string/ime_space_description"
            android:text="@string/ime_space" />

        <Button
            android:id="@+id/ime_delete"
            style="@style/Widget.FreeVoice.ImeIconKey"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/ime_delete"
            android:drawableStart="@drawable/ic_ime_backspace" />

        <Button
            android:id="@+id/ime_enter"
            style="@style/Widget.FreeVoice.ImeIconKey"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/ime_enter"
            android:drawableStart="@drawable/ic_ime_enter" />
    </LinearLayout>
</LinearLayout>
