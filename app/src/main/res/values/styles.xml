<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#006C4C</item>
    </style>

    <style name="Widget.FreeVoice.ImeKey" parent="">
        <item name="android:background">@drawable/ime_key_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ime_on_surface</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.FreeVoice.ImeTextKey" parent="Widget.FreeVoice.ImeKey">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FreeVoice.ImeIconKey" parent="Widget.FreeVoice.ImeKey">
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.FreeVoice.ImePrimaryKey" parent="">
        <item name="android:background">@drawable/ime_mic_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ime_surface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
